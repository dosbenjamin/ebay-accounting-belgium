{
  "name": "ebay-accounting-belgium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "build": "react-router build",
    "deploy": "pnpm deploy:check && wrangler deploy",
    "deploy:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && wrangler deploy --dry-run",
    "cf:typegen": "wrangler types",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.28.0",
    "@emotion/react": "^11.14.0",
    "@react-router/cloudflare": "^7.9.0",
    "@react-router/node": "^7.9.0",
    "effect": "^3.17.0",
    "fflate": "^0.8.2",
    "isbot": "^5",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.0",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.18.0"
}
